# Ăn Dặm Radar — cấu hình tuỳ chọn. Cách dễ nhất: bấm biểu tượng bánh răng (Cài đặt nguồn) trong app,
# dán khóa và bấm Lưu — app tự ghi file .env. Hoặc copy file này thành ".env" rồi điền giá trị.
# App vẫn chạy đầy đủ KHÔNG cần khoá nào; các khoá dưới đây chỉ mở thêm nguồn / tăng độ ổn định.

# Cổng chạy web (mặc định 3000)
PORT=3000

# Thời gian lưu tạm kết quả tìm kiếm (giờ). Tìm lại cùng từ khoá trong khoảng này sẽ gần như tức thì.
SEARCH_CACHE_HOURS=6

# --- Google Search + Google Shopping (khuyên dùng) ---
# Google Shopping gom giá từ gần như MỌI shop (Walmart, Tesco, Target, Amazon, Boots, Coles…) theo từng nước.
# Đăng ký miễn phí 2.500 lượt tại https://serper.dev  → copy API key vào đây.
SERPER_API_KEY=

# --- SearXNG tự host (miễn phí, không giới hạn) ---
# Meta-search gộp Google, Bing, DuckDuckGo, Brave, Qwant… chạy bằng Docker trên máy bạn:
#   docker compose -f searxng/docker-compose.yml up -d
# rồi điền:
# SEARXNG_URL=http://localhost:8888
SEARXNG_URL=

# --- Brave Search API (có hạn mức miễn phí hằng tháng) ---  https://brave.com/search/api/
BRAVE_API_KEY=

# --- Proxy chống chặn bot (mở khoá Walmart, iHerb, eBay, Boots, Asda, Coles, Chemist Warehouse, Carrefour, Coupang, Shopee) ---
# Mẫu URL có chứa {url}. Ví dụ với ScraperAPI (có gói miễn phí 1.000 lượt/tháng, https://www.scraperapi.com):
# SCRAPE_PROXY=https://api.scraperapi.com/?api_key=YOUR_KEY&url={url}
# Hoặc ScrapingBee: https://app.scrapingbee.com/api/v1/?api_key=YOUR_KEY&render_js=false&url={url}
# Hoặc ZenRows:     https://api.zenrows.com/v1/?apikey=YOUR_KEY&url={url}
# (Không bật render JS: mỗi yêu cầu chỉ tốn 1 lượt thay vì 5–10 lượt.)
SCRAPE_PROXY=
# Số yêu cầu proxy chạy cùng lúc (gói miễn phí ScraperAPI: 5). Gói cao hơn → tăng số này để phân tích NKCN nhanh hơn.
# PROXY_CONCURRENCY=5
